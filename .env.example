# Know Your Food — public auth config (safe to commit as example only)
# Copy to .env.local and fill in. Never commit real secrets.

# Verify API base (Phone OTP start/verify + optional OAuth token exchange)
# EXPO_PUBLIC_AUTH_API_URL=https://api.example.com

# Google OAuth client IDs (expo-auth-session)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Force mock even when keys are present
# EXPO_PUBLIC_AUTH_MOCK=true

# Mock SMS code when phone API is unset (default 123456)
# EXPO_PUBLIC_AUTH_MOCK_OTP=123456
