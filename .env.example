# Know Your Food — public auth config (safe to commit as example only)
# Copy to .env.local and fill in. Never commit real secrets.

# Verify API base (Phone OTP start/verify + optional OAuth token exchange).
# Must include the /api prefix used by apps/api on Vercel:
# EXPO_PUBLIC_AUTH_API_URL=https://<deployment>.vercel.app/api
# Local: EXPO_PUBLIC_AUTH_API_URL=http://localhost:3000/api

# Google Sign-In client IDs (expo-auth-session) — public IDs only, not secrets.
# Same Web client ID as Vercel GOOGLE_CLIENT_ID. Create OAuth clients in
# Google Cloud Console → APIs & Services → Credentials.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Force mock even when keys are present
# EXPO_PUBLIC_AUTH_MOCK=true

# Mock SMS code when phone API is unset (default 123456)
# EXPO_PUBLIC_AUTH_MOCK_OTP=123456
