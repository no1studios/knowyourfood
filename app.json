{
  "expo": {
    "name": "Know Your Food",
    "slug": "knowyourfood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-1024.png",
    "scheme": "knowyourfood",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.knowyourfood",
      "icon": "./assets/brand/app-icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground-1024.png",
        "backgroundImage": "./assets/brand/adaptive-background-1024.png",
        "backgroundColor": "#f7f6f2",
        "monochromeImage": "./assets/brand/adaptive-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.knowyourfood"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-mark-1024.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f7f6f2",
          "dark": {
            "image": "./assets/brand/splash-mark-dark-1024.png",
            "backgroundColor": "#121411"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
