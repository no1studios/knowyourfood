# Know Your Food API — copy to .env.local for local Next.js.
# Set the same keys in the Vercel project (Settings → Environment Variables).
# Never commit real secrets. Never paste secrets into chat.

# Postgres (Neon) — optional while AUTH_MOCK=true.
# 1) Create a Neon project → copy the pooled connection string.
# 2) Paste into Vercel → Project → Settings → Environment Variables → DATABASE_URL
#    (Production + Preview). Redeploy after saving.
# 3) Run apps/api/db/schema.sql in the Neon SQL Editor once.
DATABASE_URL=

# Auth mock mode (default true). Deterministic OTP + OAuth stubs; no SMS/OAuth calls.
# Works with or without DATABASE_URL. When DATABASE_URL is set, OTP verify upserts
# users + auth_identities and returns the DB user id.
AUTH_MOCK=true
# Accepted 6-digit code when AUTH_MOCK=true (or when SMS provider is unset)
AUTH_MOCK_OTP=123456

# SMS / Phone OTP — pick one provider when leaving mock mode
# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Or Firebase Admin / Auth
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google OAuth (server-side token verify / client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (server-side)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
