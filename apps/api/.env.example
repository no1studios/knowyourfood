# Know Your Food API — copy to .env.local for local Next.js.
# Set the same keys in the Vercel project (Settings → Environment Variables).
# Never commit real secrets. Never paste secrets into chat.

# Postgres (Neon) — optional while AUTH_MOCK=true.
# 1) Create a Neon project → copy the pooled connection string
#    (postgresql://…@…-pooler…/neondb?sslmode=require). Do NOT wrap in quotes.
# 2) Paste into Vercel → Project → Settings → Environment Variables → DATABASE_URL
#    (Production + Preview). Redeploy after saving.
# 3) Run apps/api/db/schema.sql in the Neon SQL Editor once (API also IF NOT EXISTS).
# Fallbacks also accepted: POSTGRES_URL, POSTGRES_PRISMA_URL (Neon↔Vercel integration).
DATABASE_URL=

# Auth mock mode (default true). Deterministic OTP + OAuth stubs; no SMS/OAuth calls.
# Works with or without DATABASE_URL. When DATABASE_URL is set, OTP verify still upserts
# users + auth_identities (mock only skips SMS) and returns the DB user id.
AUTH_MOCK=true
# Accepted 6-digit code when AUTH_MOCK=true (or when SMS provider is unset)
AUTH_MOCK_OTP=123456

# Extra browser origins allowed for CORS (comma-separated). Local Expo web
# http://localhost:8081|8082 and 127.0.0.1 variants are always allowed.
# Add production Expo web / preview URLs here after deploy, e.g.:
# CORS_ALLOWED_ORIGINS=https://your-expo-web.example.com
# CORS_ALLOWED_ORIGINS=

# SMS / Phone OTP — MSG91 is the live India provider (SendOTP + Verify v5).
# Leave unset while AUTH_MOCK=true. Required when AUTH_MOCK=false.
# Console: https://control.msg91.com → Authkey + OTP template (DLT-approved).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Optional: sender/header if not baked into the template (6 chars, DLT-approved)
MSG91_SENDER_ID=
# Optional overrides (defaults: 6-digit OTP, 5-minute expiry)
# MSG91_OTP_LENGTH=6
# MSG91_OTP_EXPIRY_MINUTES=5

# Not wired yet (placeholders only — prefer MSG91 for India):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Google Sign-In — ID token verify (independent of AUTH_MOCK).
# Set at least GOOGLE_CLIENT_ID (Web client). Add iOS/Android IDs if native
# tokens use those audiences. Client secret is NOT required for verify.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Optional aliases / platform audiences (same values as Expo EXPO_PUBLIC_* IDs):
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# Not used for ID-token verify (authorization-code flows only):
# GOOGLE_CLIENT_SECRET=

# Apple Sign-In (server-side) — not wired yet; mock only while AUTH_MOCK=true
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
